{
  "manifest_version": 3,
  "name": "Zwishly: free chess game review",
  "short_name": "Zwishly",
  "version": "1.0.0",
  "description": "Review your finished Chess.com and Lichess games for free on Zwishly, with one click from the game page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyze this game on Zwishly"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*", "https://lichess.org/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
